<Application x:Class="Station.ControlApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Station.ControlApp.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Palette -->
        <SolidColorBrush x:Key="BgBrush"        Color="#1E1F24"/>
        <SolidColorBrush x:Key="PanelBrush"     Color="#2A2C33"/>
        <SolidColorBrush x:Key="OutlineBrush"   Color="#3C3F48"/>
        <SolidColorBrush x:Key="TextBrush"      Color="#E6E7EA"/>
        <SolidColorBrush x:Key="MutedBrush"     Color="#8A8D96"/>
        <SolidColorBrush x:Key="AccentBrush"    Color="#4CC2FF"/>
        <SolidColorBrush x:Key="OnBrush"        Color="#4CC2FF"/>
        <SolidColorBrush x:Key="OffBrush"       Color="#3C3F48"/>
        <SolidColorBrush x:Key="DangerBrush"    Color="#FF5A5A"/>
        <SolidColorBrush x:Key="SafeBrush"      Color="#4CAF6E"/>

        <!-- Bool -> brush converters for button/D-pad indicators -->
        <conv:BoolToBrushConverter x:Key="BoolBrush"
                                   OnBrush="{StaticResource OnBrush}"
                                   OffBrush="{StaticResource OffBrush}"/>
        <conv:BoolToBrushConverter x:Key="BoolBrushDanger"
                                   OnBrush="{StaticResource DangerBrush}"
                                   OffBrush="{StaticResource OffBrush}"/>
        <!-- Armed = green, disarmed = red -->
        <conv:BoolToBrushConverter x:Key="BoolBrushArmed"
                                   OnBrush="{StaticResource SafeBrush}"
                                   OffBrush="{StaticResource DangerBrush}"/>

        <!-- A round/rounded indicator that lights up when its bound bool is true -->
        <Style x:Key="Indicator" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource OffBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <Style x:Key="IndicatorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

    </Application.Resources>
</Application>
